# Fichiers Python compilés / cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Environnements virtuels (si tu en crées un plus tard)
venv/
.venv/
env/

# Fichiers de config d'éditeurs / IDE
.vscode/
.idea/
*.swp

# Fichiers spécifiques à l'OS
Thumbs.db
desktop.ini
.DS_Store

# Fichiers de sortie/test personnels (à adapter si besoin)
*.log

