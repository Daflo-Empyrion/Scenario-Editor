# Artefacts de construction (regeneres par build.bat -- voir BUILD.md)
build/
dist/
installer_output/
*.spec.bak

# Environnement virtuel Python
venv/
.venv/

# Cache Python
__pycache__/
*.pyc
.pytest_cache/

# Icones extraites des assets du jeu par l'utilisateur (voir
# core/tech_tree_icons.py) -- gros volume (~70+ Mo), fichiers du jeu Empyrion
