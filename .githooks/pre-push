#!/bin/sh
# Garde-fou AVANT PUSH (regle 6 d'AGENTS.md) : un push qui touche le code de
# l'application doit toucher README.md dans le meme lot, sinon la nouveaute
# n'est documentee dans aucune des deux langues.
#
# Perimetre du "code applicatif" : core/, gui/, data/, les .py a la racine et
# les requirements. Les changements internes (tests/, docs/, .github/,
# tools/) ne declenchent rien : ils ne s'adressent pas a l'utilisateur.
#
# Contournement assume : `git push --no-verify` (ou refuser sciemment).
# Toute erreur d'inspection laisse passer le push : un garde-fou de qualite ne
# doit pas bloquer le travail sur une panne d'outil.

zero=0000000000000000000000000000000000000000
statut=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue                 # suppression de ref
    case "$remote_ref" in
        refs/heads/*) ;;                                   # tags : ignores
        *) continue ;;
    esac

    if [ "$remote_sha" = "$zero" ] || [ -z "$remote_sha" ]; then
        base=$(git rev-list --max-parents=0 "$local_sha" 2>/dev/null | head -1)
        [ -z "$base" ] && continue
        plage="$base..$local_sha"
    else
        plage="$remote_sha..$local_sha"
    fi

    changed=$(git diff --name-only "$plage" 2>/dev/null) || continue

    code=$(printf '%s\n' "$changed" | grep -E '^(core|gui|data)/|^[A-Za-z_]+\.py$|^requirements[^/]*\.txt$')
    if [ -n "$code" ] && ! printf '%s\n' "$changed" | grep -qx 'README\.md'; then
        echo "" >&2
        echo "PRE-PUSH REFUSE : du code applicatif change sans README.md." >&2
        echo "Fichiers concernes :" >&2
        printf '%s\n' "$code" | sed 's/^/  - /' | head -12 >&2
        echo "" >&2
        echo "Ajoute la nouveaute aux DEUX blocs du README (## Français et" >&2
        echo "## English), puis recommence. Si le changement n'a rien de" >&2
        echo "visible pour l'utilisateur, assume-le : git push --no-verify" >&2
        echo "" >&2
        statut=1
    fi
done

exit $statut
